# =============================================================================
# AlphaHunter 后端环境变量模板
# 使用方法：复制为 backend/.env 后按需修改。
# 所有变量均带 ALPHAHUNTER_ 前缀，避免与操作系统中的同名变量冲突。
# =============================================================================

# 运行环境：development / testing / production
ALPHAHUNTER_ENVIRONMENT=development

# 是否开启调试模式。生产环境请务必设为 false
ALPHAHUNTER_DEBUG=true

# 服务监听地址与端口（uvicorn 直接读取）
ALPHAHUNTER_HOST=127.0.0.1
ALPHAHUNTER_PORT=8000

# API 版本前缀
ALPHAHUNTER_API_V1_PREFIX=/api/v1

# 生产环境必须替换为随机字符串，例如：python -c "import secrets; print(secrets.token_urlsafe(48))"
ALPHAHUNTER_SECRET_KEY=change-me-before-production

# 数据库连接串。默认使用 backend/data/alphahunter.db。
# 切换到 PostgreSQL 时示例：
# ALPHAHUNTER_DATABASE_URL=postgresql+psycopg://alphahunter:password@localhost:5432/alphahunter
ALPHAHUNTER_DATABASE_URL=

# 允许跨域访问的前端地址，多个地址使用英文逗号分隔
ALPHAHUNTER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 日志级别：DEBUG / INFO / WARNING / ERROR
ALPHAHUNTER_LOG_LEVEL=INFO

# 是否打印 SQL 语句。排查问题时开启，平时关闭
ALPHAHUNTER_SQL_ECHO=false

# 首次初始化数据库时是否写入演示股票池
ALPHAHUNTER_SEED_DEMO_DATA=true

# 外部行情接口超时时间（秒）
ALPHAHUNTER_MARKET_DATA_TIMEOUT=30

# =============================================================================
# AlphaHunter 前端环境变量模板
# 复制为 .env.local 后按需修改；Vite 只把 VITE_ 前缀变量暴露给浏览器。
# =============================================================================

# 浏览器请求的 API 基础路径。默认走 Vite/Nginx 反向代理，无需填写后端域名。
VITE_API_BASE_URL=/api/v1

# 仅供 vite.config.js 开发代理使用，不会打包进浏览器。
VITE_PROXY_TARGET=http://127.0.0.1:8000

# =============================================================================
# AlphaHunter Git 忽略规则
# 说明：
# 1. 只提交源代码、配置模板和文档，不提交本机环境、数据库文件与构建产物。
# 2. 真实的 .env 文件可能包含密钥，必须保持忽略。
# =============================================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.python-version

# 测试与静态检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
backend/.test-runtime/

# ---------- 数据库与运行数据 ----------
# SQLite 本地数据库属于运行数据，不提交；data 目录通过 .gitkeep 保留。
backend/data/*.db
backend/data/*.db-*
backend/data/*.sqlite
backend/data/*.sqlite3
backend/logs/
*.log

# ---------- 环境变量与密钥 ----------
# 允许提交示例模板，禁止提交真实配置。
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ---------- 前端 ----------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
.pnpm-store/
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- 本地临时文件 ----------
# pip 在部分 Windows 沙箱环境会留下临时构建目录，统一忽略。
backend/.tmp/
backend/tmp*/
backend/pip-*/
backend/pip-*.log
.backend-pip-tmp/
frontend/.tmp/
frontend/.screenshots/
# 本地环境验证产物（截图、浏览器配置等）
.verification/
# Windows 文件权限诊断与回滚记录（不属于项目源码）
.acl-recovery/


# ---------- IDE / 操作系统 ----------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------- Docker / 临时文件 ----------
.docker/
*.tmp
*.bak

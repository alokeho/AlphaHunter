# =============================================================================
# AlphaHunter 编辑器统一规范
# 作用：让不同编辑器对缩进、换行和编码保持一致，减少无意义的代码差异。
# =============================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,yml,yaml}]
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
